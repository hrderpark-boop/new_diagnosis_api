# ─────────────────────────────────────────────────────────────
# 백엔드 환경변수 예시. 실제 값을 채워 .env 로 저장(로컬)하거나,
# 배포 시 Render 대시보드의 Environment 에 입력한다.
# 🚫 실제 값(키·비밀번호)을 이 파일에 넣지 말 것 — 이 파일은 저장소에 커밋된다.
# ─────────────────────────────────────────────────────────────

# [필수] Supabase Postgres 접속 URL. 반드시 asyncpg 드라이버 형식.
#   예: postgresql+asyncpg://USER:PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=

# [필수] JWT 서명 비밀키. 길고 무작위인 문자열(예: openssl rand -hex 32).
#   ⚠️ 개발 기본값("default_super_secret_key_for_dev")을 운영에서 절대 쓰지 말 것.
SECRET_KEY=

# [필수] Gemini API 키. 쉼표로 여러 개 나열 가능(로테이션).
#   예: GEMINI_API_KEYS=key1,key2
GEMINI_API_KEYS=

# [선택] LLM provider. 기본 claude(2026-10-29부터) — 코치 턴 → claude-haiku-5-5, 분석·서술 → claude-sonnet-5-5.
#   ANTHROPIC_API_KEY 가 필수(없으면 기동 단계에서 실패). GEMINI_API_KEYS 는 gemini 를 선택할 때만 필요.
#   gemini 로 되돌리려면 LLM_PROVIDER=gemini. 자세한 정책: docs/llm_provider.md
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=
#   모델·effort 오버라이드(미설정 = 아래 기본값 / effort 미설정 = 모델 기본 Haiku medium·Sonnet high)
# CLAUDE_CHAT_MODEL=claude-haiku-5-5
# CLAUDE_ANALYSIS_MODEL=claude-sonnet-5-5
# CLAUDE_CHAT_EFFORT=
# CLAUDE_ANALYSIS_EFFORT=
#   adaptive thinking 호출의 max_tokens 하한(thinking 토큰이 한도를 잠식해 JSON 이 잘리는 것 방지). 기본 32000.
# CLAUDE_ADAPTIVE_MAX_TOKENS=32000

# [선택] Phase 3-A 대화 흐름(제어역전·넓이게이트). 기본 true — 미설정이면 ON.
#   레거시 흐름은 품질 시스템이 전부 꺼지므로, 명시적으로 false 를 줄 때만 사용.
USE_PHASE3A=true

# [선택] 진단 파이프라인 — 기본값 있음. 필요할 때만 설정.
#   ANALYSIS_OUTER_RUNS: 교집합 분석 반복 수(기본 3). 비용 절감 시 1.
ANALYSIS_OUTER_RUNS=3
#   GROUP_CODE_ENFORCED: 그룹코드 게이트(기본 true). 문제 시 false 로 개방.
GROUP_CODE_ENFORCED=true
#   COMPOSITE_MIN_MEASURED: 종합점수 표시 임계(기본 18).
# COMPOSITE_MIN_MEASURED=18
#   ANALYSIS_TEMPERATURE: 판정 온도(기본 0=결정론).
# ANALYSIS_TEMPERATURE=0

# [선택] CORS 허용 오리진. 기본값에 https://fm.connectn.co.kr 포함.
#   다른 프론트 도메인을 추가할 때만 설정(쉼표 구분).
# CORS_ALLOWED_ORIGINS=https://fm.connectn.co.kr,http://localhost:3000

# [자동] Render 가 주입하는 포트. 로컬에선 무시(기본 8000).
# PORT=8000

# ── 운영 DB 가드 (2026-10-19) ─────────────────────────────────────────────
# ENV=production 이 아닌 환경에서 DATABASE_URL 이 Supabase 를 가리키면 앱이 기동을 거부한다.
# 로컬은 sqlite(또는 복제 DB)를 쓰고, 운영(Render)에는 ENV=production 을 넣는다(RENDER=true 자동 주입도 운영으로 본다).
# 정말 로컬에서 운영 DB 가 필요할 때만 ALLOW_PROD_DB=1 을 명시한다. 기동 로그의 DATABASE_URL 은 비밀번호가 마스킹된다.
# ENV=production
# ALLOW_PROD_DB=1
